---
import '../styles/global.scss';
import Nav from '../components/Nav.astro';

interface Props {
  title: string;
  weather?: 'always' | 'toggle';
}

const { title, weather = 'toggle' } = Astro.props;
const startseite = weather === 'always';
---

<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class={startseite ? 'is-home' : 'is-artikel'} data-weather={weather}>
    <canvas id="rain" aria-hidden="true"></canvas>
    <div id="glow" aria-hidden="true"></div>
    <div id="flash" aria-hidden="true"></div>
    <svg id="bolts" aria-hidden="true">
      <defs>
        <filter id="boltglow" x="-40%" y="-40%" width="180%" height="180%">
          <feGaussianBlur stdDeviation="3" result="b"></feGaussianBlur>
          <feMerge>
            <feMergeNode in="b"></feMergeNode>
            <feMergeNode in="SourceGraphic"></feMergeNode>
          </feMerge>
        </filter>
      </defs>
    </svg>

    {!startseite && (
      <header class="kopf">
        <Nav />
        <button type="button" class="wetter" id="wetter-schalter" aria-pressed="false">Wetter: aus</button>
      </header>
    )}

    <slot />

    <script>
      import { bootWeather } from '../scripts/weather';
      const mode = document.body.dataset.weather === 'always' ? 'always' : 'toggle';
      bootWeather(mode);
    </script>
  </body>
</html>
